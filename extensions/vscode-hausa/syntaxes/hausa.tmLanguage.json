{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Hausa Python",
  "scopeName": "source.hausa",
  "patterns": [
    {
      "name": "comment.line.number-sign.hausa",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.hausa",
      "begin": "\"",
      "end": "\""
    },
    {
      "name": "string.quoted.single.hausa",
      "begin": "'",
      "end": "'"
    },
    {
      "name": "keyword.control.hausa",
      "match": "\\b(buga|shigar|idan|sauran_idan|in_ba_haka_ba|ga|cikin|yayin|tsaya|wuce|aiki|mayar|aji|kamar|babban_gari|ba_na_ciki|goge|dace|hali|gwada|kama|karshe|tada|tabbatar|tare_da|daga|shigo|karya|gaskiya|babu|kuma|ko|ba|shi_ne|babu_guda|jira|alamun_haske|wuce_kawai|lamba|lamba_dige|rubutu|jeri|makullai|bude_rufa|binciko|saka_cikin|sabunta|goge_daga|tebur|kunshe_bayanai|takarda|nemo_guda|saka_guda|Abokin_Hadin_Mongo|Injin_Yanar_Gizo|bude_hanya|bukata|buƙata|amsa|tsarin_bayanai|juya_zuwa_json|rufe_sirri)\\b"
    }
  ]
}