{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Hausa Rust",
  "scopeName": "source.hrust",
  "patterns": [
    {
      "name": "constant.language.hrust",
      "match": "(?<![\\w'])(?:gaskiya|karya)(?![\\w'])"
    },
    {
      "name": "storage.modifier.hrust",
      "match": "(?<![\\w'])(?:sauye_sauye|KAI_TSAYE|kai_tsaye|tsayayye|aiwatar|lissafi|akwati|amfani|hadari|jama'a|babba|nau'i|sashe|tsari|hali|nuni|waje)(?![\\w'])"
    },
    {
      "name": "keyword.control.hrust",
      "match": "(?<![\\w'])(?:in_ba_haka_ba|tabbatacce|babu_guda|zagaye|cikin|kamar|mayar|motsa|sauya|tsaya|yayin|aiki|bari|dace|idan|inda|jira|wuce|aji|ga)(?![\\w'])"
    },
    {
      "include": "source.rust"
    }
  ]
}